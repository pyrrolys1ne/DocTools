<Window x:Class="DocTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:DocTools.Converters"
        xmlns:views="clr-namespace:DocTools.Views"
        Title="DocTools" Height="760" Width="1080" MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.PageBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:IconKeyToGeometryConverter x:Key="IconConv"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource Brush.TitleBar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="Assets/icon.png" Width="18" Height="18"/>
                <TextBlock Text="DocTools" Margin="9,0,0,0" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Click="CheckUpdatesClick" ToolTip="检查更新">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="DiagnosticsClick" ToolTip="导出诊断报告">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="ThemeClick" ToolTip="切换主题">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE706;" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="MinimizeClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="MaximizeClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE922;" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="CloseClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Brush.NavBackground}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,22,18,10">
                        <TextBlock Text="DocTools" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBlock Text="本地文档处理" FontSize="12.5" Margin="0,5,0,0"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding OperationsView}" SelectedItem="{Binding SelectedOperation}"
                             Style="{StaticResource NavList}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="22,15,18,5" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <!-- 依赖引擎不可用时禁用该操作（能力清单来自 /api/v1/capabilities） -->
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding IconKey, Converter={StaticResource IconConv}}"
                                          Style="{StaticResource NavIcon}" Width="17" Height="17"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"/>
                                    <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Selected wide-workspace design: one rounded work surface beside the navigation shell. -->
            <Border Grid.Column="1" Margin="0,10,10,10"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="34,30,34,34">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                                Padding="0,0,0,20" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedOperationLabel}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <TextBlock Text="{Binding SelectedOperationHint}" Foreground="{DynamicResource Brush.TextMuted}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"/>
                            </StackPanel>
                        </Border>
                        <views:OperationForm/>
                        <views:RunStatus Margin="0,18,0,0"/>
                        <views:ResultsPanel Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
