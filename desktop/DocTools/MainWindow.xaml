<Window x:Class="DocTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:DocTools.Converters"
        xmlns:views="clr-namespace:DocTools.Views"
        Title="DocTools" Height="760" Width="1080" MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.PageBackground}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:IconKeyToGeometryConverter x:Key="IconConv"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource Brush.TitleBar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="Assets/icon.png" Width="18" Height="18"/>
                <TextBlock Text="DocTools" Margin="9,0,0,0" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Command="{Binding OpenSettingsCommand}" ToolTip="设置（MinerU 等）">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="CheckUpdatesClick" ToolTip="检查更新">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="DiagnosticsClick" ToolTip="导出诊断报告">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="ThemeClick" ToolTip="切换主题">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE706;" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="MinimizeClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="MaximizeClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE922;" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="CloseClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Border Margin="0,10,10,10"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <!-- 主页：按输入文件格式分类的卡片 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="34,30,34,34"
                                  Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="DocTools" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="本地文档处理 · 选择一个输入文件类型开始"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="13" Margin="0,6,0,26"/>
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CardButton}" Width="300" Height="150"
                                                Margin="0,0,18,18"
                                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{Binding IconKey, Converter={StaticResource IconConv}}"
                                                          Style="{StaticResource NavIcon}" Width="26" Height="26"
                                                          Stroke="{DynamicResource Brush.Primary}" Stretch="Uniform"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"
                                                           VerticalAlignment="Bottom" Margin="0,14,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 分类页：该分类下的功能卡片 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="34,30,34,34"
                                  Visibility="{Binding IsCategoryVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="‹ 返回" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BackCommand}"/>
                                <TextBlock Text="{Binding CurrentCategoryLabel}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding CurrentCategory.Operations}" Margin="0,22,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CardButton}" Width="220" Height="96"
                                                Margin="0,0,14,14"
                                                Command="{Binding DataContext.SelectOperationCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsAvailable}"
                                                ToolTip="{Binding UnavailableReason}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{Binding IconKey, Converter={StaticResource IconConv}}"
                                                      Style="{StaticResource NavIcon}" Width="20" Height="20"
                                                      Stroke="{DynamicResource Brush.Primary}" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding Label}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 操作页：现有表单 + 结果 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="34,30,34,34"
                                  Visibility="{Binding IsOperationVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Button Content="‹ 返回" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BackCommand}" HorizontalAlignment="Left"/>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                                    Padding="0,0,0,20" Margin="0,20,0,24">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedOperationLabel}" FontSize="24" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <TextBlock Text="{Binding SelectedOperationHint}" Foreground="{DynamicResource Brush.TextMuted}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"/>
                                </StackPanel>
                            </Border>
                            <views:OperationForm/>
                            <views:RunStatus Margin="0,18,0,0"/>
                            <views:ResultsPanel Margin="0,18,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
