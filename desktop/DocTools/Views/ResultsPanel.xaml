<UserControl x:Class="DocTools.Views.ResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Style="{StaticResource Card}"
            Visibility="{Binding ResultsCardVisible, Converter={StaticResource BoolToVis}}">
        <StackPanel>
            <TextBlock Text="处理结果" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource Brush.TextPrimary}"/>
            <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource Brush.TextMuted}"
                       FontSize="12" Margin="0,2,0,10"/>
            <DataGrid ItemsSource="{Binding Results}" Style="{StaticResource ResultGrid}" MaxHeight="300">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="状态" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Padding="7,2" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding OkText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="源文件" Binding="{Binding Src}" Width="*"/>
                    <DataGridTextColumn Header="输出" Binding="{Binding Dst}" Width="*"/>
                    <DataGridTextColumn Header="错误" Binding="{Binding DisplayError}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Border>
</UserControl>
