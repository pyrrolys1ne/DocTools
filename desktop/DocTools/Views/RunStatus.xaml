<UserControl x:Class="DocTools.Views.RunStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel>
        <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource Brush.DangerSoft}" CornerRadius="10" Padding="14,12"
                Margin="0,0,0,14">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}"
                       TextWrapping="Wrap" FontSize="12.5"/>
        </Border>
        <Border Style="{StaticResource Card}"
                Visibility="{Binding IsRunningVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent}" FontSize="12.5"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </DockPanel>
                <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding Progress}"
                             Foreground="{DynamicResource Brush.Primary}"
                             Background="{DynamicResource Brush.Border}" BorderThickness="0" Margin="0,13,0,0"/>
                <TextBlock Text="{Binding CurrentFile}" Foreground="{DynamicResource Brush.TextMuted}"
                           FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
