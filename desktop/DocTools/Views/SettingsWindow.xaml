<Window x:Class="DocTools.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="480" Height="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="MinerU 在线解析" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextPrimary}"/>
            <TextBlock Text="填一个 Token 即可使用官方 mineru.net；或填自建 mineru-api 服务地址（数据不出内网）。"
                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Token / Key" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding MineruToken, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputBox}" Padding="12,8"/>
            <TextBlock Text="仅填 Token 时默认使用官方 mineru.net（mineru.net/apiManage/token 申请）"
                       FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextMuted}"/>

            <TextBlock Text="API 地址（可选，自建 mineru-api 时填）" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
            <TextBox Text="{Binding MineruApiUrl, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputBox}" Padding="12,8"/>
            <TextBlock Text="例如 http://192.168.1.10:8000；留空则使用官方 mineru.net"
                       FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="提示：保存后本地服务会自动重启并生效，无需重启整个应用。"
                   FontSize="11" Margin="0,12,0,0" Foreground="{DynamicResource Brush.TextMuted}"
                   VerticalAlignment="Top" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="96"
                    Click="SaveClick"/>
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="96" Margin="10,0,0,0"
                    Click="CancelClick"/>
        </StackPanel>
    </Grid>
</Window>
