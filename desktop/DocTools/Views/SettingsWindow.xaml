<Window x:Class="DocTools.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="500" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
            <StackPanel>
                <!-- 通用设置 -->
                <TextBlock Text="通用" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                <StackPanel Margin="0,12,0,0">
                    <Button Content="检查更新" Style="{StaticResource SecondaryButton}" Width="160"
                            HorizontalAlignment="Left" Command="{Binding CheckUpdatesCommand}"/>
                    <Button Content="导出诊断报告" Style="{StaticResource SecondaryButton}" Width="160"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding ExportDiagnosticsCommand}"/>
                    <Button Content="切换浅色/深色主题" Style="{StaticResource SecondaryButton}" Width="160"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding ToggleThemeCommand}"/>
                </StackPanel>

                <!-- MinerU 配置 -->
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                        Margin="0,22,0,0" Padding="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="MinerU 在线解析" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBlock Text="填一个 Token 即可使用官方 mineru.net；或填自建 mineru-api 服务地址（数据不出内网）。"
                                   TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>

                        <TextBlock Text="Token / Key" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBox Text="{Binding MineruToken, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}"/>
                        <TextBlock Text="仅填 Token 时默认使用官方 mineru.net（mineru.net/apiManage/token 申请）"
                                   FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextMuted}"/>

                        <TextBlock Text="API 地址（可选，自建 mineru-api 时填）" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                        <TextBox Text="{Binding MineruApiUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}"/>
                        <TextBlock Text="例如 http://192.168.1.10:8000；留空则使用官方 mineru.net"
                                   FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextMuted}"/>

                        <TextBlock Text="保存后本地服务会自动重启并生效，无需重启整个应用。"
                                   FontSize="11" Margin="0,12,0,0" Foreground="{DynamicResource Brush.TextMuted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12,24,20">
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="100" Click="SaveClick"/>
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="100" Margin="10,0,0,0"
                    Click="CancelClick"/>
        </StackPanel>
    </Grid>
</Window>
