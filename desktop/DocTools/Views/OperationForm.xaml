<UserControl x:Class="DocTools.Views.OperationForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel>
        <StackPanel Visibility="{Binding IsBatchVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="源路径（文件或目录，可拖入）" Style="{StaticResource FieldLabel}"/>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="选择目录" Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseDirCommand}" Margin="8,0,0,0"/>
                    <Button Content="选择文件" Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseFileCommand}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"/>
            </DockPanel>
            <TextBlock Text="输出目录（可选，默认生成在源路径旁）" Style="{StaticResource FieldLabel}" Margin="0,18,0,5"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="选择目录" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseOutputDirCommand}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <CheckBox Content="递归处理子目录" IsChecked="{Binding IsRecursive}"
                          Style="{StaticResource CheckBoxStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="28,0,0,0"
                            Visibility="{Binding IsCompressVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="质量" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,10,0" FontSize="12.5"/>
                    <Slider Width="220" Minimum="1" Maximum="100" Value="{Binding Quality}"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Quality}" Margin="8,0,0,0" MinWidth="26"
                               Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Visibility="{Binding IsMergeVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="添加 PDF" Style="{StaticResource SecondaryButton}"
                        Command="{Binding AddMergeFilesCommand}"/>
                <TextBlock Text="按添加顺序合并以下文件" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="12.5"/>
            </DockPanel>
            <ListBox ItemsSource="{Binding MergeSources}" Height="150" Style="{StaticResource PlainListBox}"/>
            <TextBlock Text="输出 PDF 文件" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="选择文件" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseMergeOutputCommand}" Margin="6,0,0,0"/>
                <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Visibility="{Binding IsSplitVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="源 PDF 文件" Style="{StaticResource FieldLabel}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="选择文件" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseFileCommand}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"/>
            </DockPanel>
            <TextBlock Text="输出目录（可选，默认生成在源路径旁）" Style="{StaticResource FieldLabel}" Margin="0,18,0,5"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="选择目录" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseOutputDirCommand}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"/>
            </DockPanel>
            <TextBlock Text="页码范围（如 1-3,5,8-12；留空则每页一个）" Style="{StaticResource FieldLabel}" Margin="0,18,0,5"/>
            <TextBox Text="{Binding PageRanges, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
        </StackPanel>

        <StackPanel Visibility="{Binding IsPdfToImagesVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="源 PDF 文件" Style="{StaticResource FieldLabel}"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="选择文件" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseFileCommand}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"/>
            </DockPanel>
            <TextBlock Text="输出目录（可选，默认生成在源路径旁）" Style="{StaticResource FieldLabel}" Margin="0,18,0,5"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="选择目录" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseOutputDirCommand}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}"/>
            </DockPanel>
        </StackPanel>

        <Button Content="开始处理" Style="{StaticResource PrimaryButton}"
                Command="{Binding StartCommand}" IsEnabled="{Binding NotBusy}"
                HorizontalAlignment="Left" Margin="0,22,0,0"/>
    </StackPanel>
</UserControl>
